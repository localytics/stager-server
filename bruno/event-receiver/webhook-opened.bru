meta {
  name: Webhook pull request opened
  type: http
  seq: 3
  tags: [
    docker
  ]
}

post {
  url: {{baseUrl}}/event_receiver
  body: json
  auth: basic
}

auth:basic {
  username: {{hookUser}}
  password: {{hookPassword}}
}

body:json {
  {
    "action": "opened"
  }
}

script:pre-request {
  const crypto = require('crypto');
  const payload = {
    action: 'opened',
    pull_request: {
      number: 7,
      head: {
        ref: bru.getEnvVar('containerName'),
        repo: { name: bru.getEnvVar('imageName') }
      },
      base: {
        repo: { owner: { login: bru.getEnvVar('repoOwner') } }
      }
    }
  };
  const body = JSON.stringify(payload);
  const signature = crypto.createHmac('sha1', bru.getEnvVar('hookSecret')).update(body).digest('hex');
  req.setHeader('Content-Type', 'application/json');
  req.setHeader('X-Hub-Signature', 'sha1=' + signature);
  req.setBody(body);
}

docs {
  Signs the body with hookSecret and sends it as X-Hub-Signature.
  A matching image and a running Docker daemon are required. The response is the staged URL.
}

tests {
  test("launches from an opened pull request", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.a("string");
  });
}
