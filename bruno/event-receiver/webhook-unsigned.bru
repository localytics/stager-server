meta {
  name: Webhook unsigned
  type: http
  seq: 2
  tags: [
    smoke
  ]
}

post {
  url: {{baseUrl}}/event_receiver
  body: json
  auth: basic
}

auth:basic {
  username: {{hookUser}}
  password: {{hookPassword}}
}

body:json {
  {
    "action": "opened",
    "pull_request": {
      "number": 7,
      "head": {
        "ref": "{{containerName}}",
        "repo": { "name": "{{imageName}}" }
      },
      "base": {
        "repo": { "owner": { "login": "{{repoOwner}}" } }
      }
    }
  }
}

docs {
  Basic auth without X-Hub-Signature is ignored. The response is empty and Docker is not contacted.
}

tests {
  test("ignores an unsigned webhook", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.equal("");
  });
}
