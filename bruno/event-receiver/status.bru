meta {
  name: Status
  type: http
  seq: 5
  tags: [
    docker
  ]
}

get {
  url: {{baseUrl}}/event_receiver?action=status&image_name={{imageName}}&github_token={{githubToken}}
  body: none
  auth: none
}

docs {
  Lists running containers for the image. Docker is contacted before the token is checked.
}

tests {
  test("returns a container list", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
  });
}
